rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Contact and quotation forms are public-facing: anyone can submit (create),
    // and the admin page reads the same collections client-side with no
    // server-verified login, so read is also open. Do not add other
    // collections under this same open policy.
    match /contacts/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    match /quotations/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    match /jobs/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /job_applications/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    match /linkedin_posts/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
